---
---

<section class="hero" id="home">
  <div class="container hero-inner">
    <p class="eyebrow">MSc Applied AI &amp; Data Analytics — University of Bradford</p>
    <h1>
      Simon Akporowhe — turning operational data into
      <span class="highlight">decisions that hold up.</span>
    </h1>
    <p class="hero-sub">
      I build machine learning models and BI dashboards that translate messy,
      real-world data into predictions and insight teams can act on — from
      predicting equipment failure across a decade of infrastructure data to
      dashboards that surface where attrition and support bottlenecks actually
      come from.
    </p>
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">View projects</a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>

    <dl class="hero-stats">
      <div>
        <dt>8</dt>
        <dd>ML algorithms compared</dd>
      </div>
      <div>
        <dt>3.9M+</dt>
        <dd>Records analyzed</dd>
      </div>
      <div>
        <dt>10 yrs</dt>
        <dd>Of operational data</dd>
      </div>
      <div>
        <dt>0</dt>
        <dd>New sensors required</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: 88px;
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 820px;
  }

  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    margin: 0 0 24px;
  }

  .highlight {
    color: var(--accent);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--ink-secondary);
    max-width: 640px;
    margin-bottom: 36px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 64px;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .hero-stats dt {
    font-family: var(--font-mono);
    font-size: clamp(1.3rem, 2.5vw, 1.9rem);
    font-weight: 650;
    color: var(--ink);
  }

  .hero-stats dd {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: var(--ink-muted);
  }

  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 24px;
    }
  }
</style>
