---
import ImageSlot from './ImageSlot.astro';
import StatTile from './StatTile.astro';

// Add future roles/placements here — newest first. Each entry renders as its
// own card; nothing else in this file needs to change to add one.
const experiences = [
  {
    company: 'Beyond Tech',
    role: 'Research and Product Intern',
    type: 'Study Internship',
    duration: 'May – July 2026 · 3 months',
    logo: {
      src: '/images/experience/beyond-tech/logo.png',
      alt: 'Beyond Tech logo',
    },
    summary: [
      'Beyond Tech is a UK-based Global Talent Visa consultancy that helps tech professionals — founders, CTOs, senior engineers, and AI researchers — build credible evidence portfolios for their visa applications, placing them at conferences, podcasts, publications, and awards across Europe and the UK.',
      'I researched and verified opportunities for clients, built an AI-assisted research workflow the team adopted, and independently designed and shipped a full-stack platform to track it all.',
    ],
    responsibilities: [
      'Researched and verified tech events, awards, and publications for client evidence portfolios, citing exact URLs and verbatim quotes against primary sources',
      'Owned profile-fit opportunity research for 4 clients in the infrastructure/SRE engineering cluster, including engineers at Meta and TON/Telegram',
      'Built a prompt library for AI-assisted research with Claude — verifying sources, extracting data, and producing citation-standard notes — later adopted team-wide as a resource for future interns',
      'Independently designed, built, and deployed the BeyondTech Portfolio Platform, a full-stack tool tracking client opportunities and visa evidence end-to-end',
    ],
    tools: [
      'Next.js',
      'Tailwind CSS',
      'Supabase',
      'PostgreSQL',
      'Vercel',
      'Resend',
      'Claude (Anthropic)',
      'Prompt Engineering',
    ],
    stats: [
      { value: '4', label: 'Clients researched (Infra/SRE cluster)', tone: 'good' },
      { value: '9', label: 'Conferences & summits mapped' },
      { value: '7', label: 'Awards & recognitions researched' },
      { value: '130+', label: 'Ecosystem library entries built', tone: 'good' },
    ],
    outcome:
      "Independently shipped the BeyondTech Portfolio Platform — live and used by the team — well beyond the internship's original scope. The supervisor responded positively, with a view to integrating it into the team's ongoing workflow.",
  },
];
---

<section id="experience">
  <div class="container">
    <p class="eyebrow">Experience</p>
    <h2 class="section-heading">Where I've put this to work</h2>
    <p class="section-intro">
      Placement experience applying research rigor and full-stack development
      to a real operational problem, not just coursework.
    </p>

    <div class="experience-list">
      {experiences.map((exp) => (
        <article class="card experience-card">
          <div class="experience-header">
            <div class="experience-header-main">
              <div class="experience-logo">
                <ImageSlot src={exp.logo.src} alt={exp.logo.alt} ratio="1/1" fit="contain" />
              </div>
              <div class="experience-heading-text">
                <h3>{exp.role}</h3>
                <p class="experience-meta">{exp.company} · {exp.duration}</p>
              </div>
            </div>
            {exp.type && <span class="tag experience-type">{exp.type}</span>}
          </div>

          {exp.summary.map((para) => (
            <p class="experience-summary">{para}</p>
          ))}

          <h4 class="experience-subheading">Key contributions</h4>
          <ul class="experience-responsibilities">
            {exp.responsibilities.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="tag-row">
            {exp.tools.map((tool) => (
              <span class="tag">{tool}</span>
            ))}
          </div>

          <div class="stat-row">
            {exp.stats.map((stat) => (
              <StatTile value={stat.value} label={stat.label} tone={stat.tone} />
            ))}
          </div>

          {exp.outcome && (
            <p class="result-line">
              <strong>Outcome:</strong> {exp.outcome}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-card {
    padding: 40px;
    margin-bottom: 28px;
  }

  .experience-card:last-child {
    margin-bottom: 0;
  }

  .experience-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }

  .experience-header-main {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
    min-width: 0;
  }

  .experience-logo {
    flex: none;
    width: 72px;
  }

  .experience-logo :global(.image-slot-hint) {
    display: none;
  }

  .experience-logo :global(.image-slot-icon) {
    font-size: 1.1rem;
  }

  .experience-logo :global(.image-slot-label) {
    font-size: 0.6rem;
    line-height: 1.2;
  }

  .experience-logo :global(.image-slot-fallback) {
    padding: 6px;
    gap: 3px;
  }

  .experience-heading-text {
    flex: 1;
    min-width: 0;
  }

  .experience-heading-text h3 {
    font-size: 1.5rem;
    margin-bottom: 6px;
  }

  .experience-meta {
    color: var(--ink-secondary);
    font-size: 0.95rem;
  }

  .experience-type {
    flex: none;
  }

  .experience-summary {
    color: var(--ink-secondary);
    margin-bottom: 16px;
  }

  .experience-summary:last-of-type {
    margin-bottom: 24px;
  }

  .experience-subheading {
    font-size: 0.95rem;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .experience-responsibilities {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .experience-responsibilities li {
    position: relative;
    padding-left: 20px;
    color: var(--ink-secondary);
    font-size: 0.95rem;
  }

  .experience-responsibilities li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--accent);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 28px;
  }

  .result-line {
    font-size: 0.92rem;
    color: var(--ink-secondary);
  }

  .result-line strong {
    color: var(--good);
  }

  @media (max-width: 980px) {
    .stat-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .experience-card {
      padding: 28px;
    }

    .experience-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .experience-logo {
      width: 56px;
    }
  }
</style>
