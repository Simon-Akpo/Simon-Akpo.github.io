---
// Renders the real image once it exists at `src` inside /public.
// Until then (or if it 404s) it falls back to a styled placeholder
// showing exactly where to drop the file — no markup changes needed later.
interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: string;
  /** "cover" fills and crops (screenshots); "contain" letterboxes so nothing
   * is cropped (charts/plots where edge labels matter). */
  fit?: 'cover' | 'contain';
}

const { src, alt, caption, ratio = '16/10', fit = 'cover' } = Astro.props;
---

<figure class="image-slot-wrap">
  <div class:list={['image-slot', `fit-${fit}`]} style={`aspect-ratio:${ratio}`}>
    <div class="image-slot-fallback">
      <span class="image-slot-icon" aria-hidden="true">◱</span>
      <span class="image-slot-label">Add screenshot</span>
      <span class="image-slot-hint">public{src}</span>
    </div>
    <img
      src={src}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="lightbox-trigger"
      tabindex="0"
      role="button"
      aria-label={`View larger image: ${alt}`}
      onerror="this.closest('.image-slot')?.classList.add('image-slot--broken'); this.style.display='none';"
    />
    <span class="zoom-hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
    </span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .image-slot-wrap {
    margin: 0;
  }

  .image-slot {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface-raised);
  }

  .image-slot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
  }

  .image-slot img:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .image-slot.fit-cover img {
    object-fit: cover;
  }

  .image-slot.fit-contain img {
    object-fit: contain;
  }

  .zoom-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .image-slot:hover .zoom-hint,
  .image-slot:focus-within .zoom-hint {
    opacity: 1;
  }

  .image-slot--broken img,
  .image-slot--broken .zoom-hint {
    display: none;
  }

  .image-slot.fit-contain {
    background: #f4f4f2;
  }

  .image-slot.fit-contain .image-slot-fallback {
    color: #6b6a66;
  }

  .image-slot-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 16px;
    text-align: center;
    color: var(--ink-muted);
  }

  .image-slot-icon {
    font-size: 1.6rem;
    color: var(--ink-secondary);
  }

  .image-slot-label {
    font-size: 0.85rem;
    color: var(--ink-secondary);
  }

  .image-slot-hint {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    word-break: break-all;
  }

  figcaption {
    margin-top: 10px;
    font-size: 0.85rem;
    color: var(--ink-muted);
    text-align: center;
  }
</style>
