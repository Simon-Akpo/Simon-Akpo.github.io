<!--
  Single shared lightbox overlay for every ImageSlot on the page.
  ImageSlot marks its <img> with class="lightbox-trigger"; this component
  owns the one overlay + the delegated click/keyboard logic that opens it.
-->
<div id="lightbox-overlay" class="lightbox-overlay" hidden>
  <button type="button" class="lightbox-close" aria-label="Close image">&times;</button>
  <img class="lightbox-img" src="" alt="" />
</div>

<style>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px;
    background: rgba(0, 0, 0, 0.85);
    animation: lightbox-fade-in 0.15s ease;
  }

  .lightbox-overlay[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: 90vw;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    cursor: pointer;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .lightbox-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @keyframes lightbox-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  :global(body.lightbox-open) {
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .lightbox-overlay {
      padding: 24px;
    }
  }
</style>

<script>
  function initLightbox() {
    const overlay = document.getElementById('lightbox-overlay');
    if (!overlay) return;

    const imgEl = overlay.querySelector<HTMLImageElement>('.lightbox-img');
    const closeBtn = overlay.querySelector<HTMLButtonElement>('.lightbox-close');
    if (!imgEl || !closeBtn) return;

    let lastFocused: HTMLElement | null = null;

    function openLightbox(trigger: HTMLImageElement) {
      lastFocused = document.activeElement as HTMLElement | null;
      imgEl.src = trigger.currentSrc || trigger.src;
      imgEl.alt = trigger.alt;
      overlay.hidden = false;
      document.body.classList.add('lightbox-open');
      closeBtn.focus();
    }

    function closeLightbox() {
      if (overlay.hidden) return;
      overlay.hidden = true;
      document.body.classList.remove('lightbox-open');
      imgEl.src = '';
      lastFocused?.focus();
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const trigger = target.closest<HTMLImageElement>('img.lightbox-trigger');
      if (trigger && trigger.style.display !== 'none') {
        openLightbox(trigger);
        return;
      }

      if (target === overlay) {
        closeLightbox();
      }
    });

    closeBtn.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeLightbox();
        return;
      }

      if (e.key === 'Enter' || e.key === ' ') {
        const active = document.activeElement as HTMLElement | null;
        if (active?.classList.contains('lightbox-trigger') && active.style.display !== 'none') {
          e.preventDefault();
          openLightbox(active as HTMLImageElement);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
