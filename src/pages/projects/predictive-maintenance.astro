---
import Layout from '../../layouts/Layout.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import StatTile from '../../components/StatTile.astro';

const gallery = [
  {
    src: '/images/projects/predictive-maintenance/01-data-pipeline.png',
    alt: 'Data pipeline and feature engineering overview diagram',
    caption: 'Data pipeline & feature engineering overview',
    ratio: '3/4',
  },
  {
    src: '/images/projects/predictive-maintenance/02-model-comparison.png',
    alt: 'Chart ranking all eight algorithms by F1 score and ROC AUC',
    caption: 'Model ranking across all 8 algorithms — F1 and ROC AUC',
    ratio: '5/2',
  },
  {
    src: '/images/projects/predictive-maintenance/03-overfitting-gap.png',
    alt: 'Chart comparing train/test overfitting gap across models',
    caption: 'Overfitting gap — why Random Forest was excluded despite a competitive F1',
    ratio: '8/5',
  },
  {
    src: '/images/projects/predictive-maintenance/04-roc-curves.png',
    alt: 'ROC curve comparison across all models',
    caption: 'ROC curve comparison',
    ratio: '1/1',
  },
  {
    src: '/images/projects/predictive-maintenance/05-confusion-matrix.png',
    alt: 'Confusion matrix for the best performing model, LightGBM',
    caption: 'Confusion matrix — LightGBM (best model)',
    ratio: '2/1',
  },
  {
    src: '/images/projects/predictive-maintenance/06-feature-importance.png',
    alt: 'LightGBM feature importance chart',
    caption: 'LightGBM feature importance',
    ratio: '4/3',
  },
  {
    src: '/images/projects/predictive-maintenance/07-cross-model-importance.png',
    alt: 'Heatmap of feature importance across all eight models',
    caption: 'Feature importance across all 8 models (cross-model heatmap)',
    ratio: '1/1',
  },
  {
    src: '/images/projects/predictive-maintenance/08-failure-rate-by-age.png',
    alt: 'Chart showing equipment failure rate rising with age',
    caption: 'Failure rate by equipment age — a wear-out pattern, not classic bathtub-shaped',
    ratio: '16/9',
  },
];

const steps = [
  {
    title: 'The problem',
    body: "A UK critical power infrastructure operator needed to anticipate equipment failure before it happened, but installing new sensor hardware across the estate wasn't a realistic option in the short term. The brief was to find out whether failure could be predicted from data the company already collected.",
  },
  {
    title: 'The data',
    body: 'Ten years of operational history — 3.9M+ records — covering equipment behaviour over time. The bulk of the work was cleaning, structuring, and engineering features from this history so it was usable for modelling, without any additional instrumentation.',
  },
  {
    title: 'The approach',
    body: 'Eight machine learning algorithms were built and benchmarked against each other, including LightGBM, to compare gradient-boosted, tree-based, and baseline approaches under consistent evaluation conditions.',
  },
  {
    title: 'Evaluation',
    body: 'Models were assessed on their ability to correctly flag at-risk equipment ahead of failure — not just raw accuracy — since false negatives (missed failures) and false positives (unnecessary maintenance call-outs) carry very different real-world costs.',
  },
  {
    title: 'The outcome',
    body: 'A working comparison of eight modelling approaches on the same infrastructure dataset, giving a clear, evidence-based answer on which algorithm family is best suited to failure prediction for this operator — using existing data, with no new sensor investment required.',
  },
];
---

<Layout
  title="Predictive Maintenance for Critical Power Infrastructure — Simon Akporowhe"
  description="MSc dissertation case study: 8 machine learning algorithms, including LightGBM, compared to predict equipment failure across 10 years and 3.9M+ records of UK critical power infrastructure data."
  path="/projects/predictive-maintenance/"
>
  <article class="case-study">
    <header class="case-header">
      <div class="container">
        <a href="/#projects" class="back-link">← Back to projects</a>
        <span class="tag project-kicker">Flagship — MSc Dissertation</span>
        <h1>Predictive Maintenance for Critical Power Infrastructure</h1>
        <p class="case-sub">
          Comparing eight machine learning algorithms to predict equipment
          failure from ten years of operational data — no new sensors
          required.
        </p>

        <div class="stat-row">
          <StatTile value="8" label="ML algorithms compared" />
          <StatTile value="3.9M+" label="Operational records" tone="good" />
          <StatTile value="10 yrs" label="Of historical data" />
          <StatTile value="0" label="New sensors required" tone="good" />
        </div>
      </div>
    </header>

    <section class="case-section">
      <div class="container">
        <h2 class="section-heading">Methodology</h2>
        <ol class="steps">
          {steps.map((step, i) => (
            <li class="step">
              <span class="step-index">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="case-section">
      <div class="container">
        <h2 class="section-heading">Gallery</h2>
        <p class="section-intro">
          Charts and visuals from the dissertation — model comparisons,
          feature importance, and evaluation diagnostics.
        </p>
        <div class="gallery-grid">
          {gallery.map((item) => (
            <ImageSlot src={item.src} alt={item.alt} caption={item.caption} ratio={item.ratio} fit="contain" />
          ))}
        </div>
      </div>
    </section>

    <section class="case-section case-cta">
      <div class="container">
        <h2 class="section-heading">Interested in the details?</h2>
        <p class="section-intro">
          I'm happy to walk through the modelling choices, evaluation metrics,
          or the full dissertation on request.
        </p>
        <a class="btn btn-primary" href="/#contact">Get in touch</a>
        <a class="btn btn-ghost" href="/#projects">See other projects</a>
      </div>
    </section>
  </article>
</Layout>

<style>
  .case-header {
    padding: 48px 0 64px;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    display: inline-block;
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 24px;
  }

  .back-link:hover {
    color: var(--ink);
  }

  .project-kicker {
    color: var(--accent);
    border-color: rgba(57, 135, 229, 0.35);
    margin-bottom: 18px;
  }

  .case-header h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    max-width: 760px;
    margin-bottom: 16px;
  }

  .case-sub {
    color: var(--ink-secondary);
    font-size: 1.1rem;
    max-width: 620px;
    margin-bottom: 40px;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .case-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--border);
  }

  .case-section:last-of-type {
    border-bottom: none;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 760px;
  }

  .step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
  }

  .step-index {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.95rem;
  }

  .step h3 {
    font-size: 1.15rem;
    margin-bottom: 10px;
  }

  .step p {
    color: var(--ink-secondary);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .case-cta .btn {
    margin-right: 12px;
  }

  @media (max-width: 640px) {
    .stat-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .step {
      grid-template-columns: 40px 1fr;
    }
  }
</style>
